{
  "schemaVersion": 1,
  "id": "lutils",
  "version": "${version}",
  "name": "LUtils",
  "description": "Some stuff to improve QOL, mostly on oldfrog.org.",
  "authors": [
    "Lord_Loading",
    "zOnlyKroks"
  ],
  "contact": {
    "sources": "https://github.com/LordLoading/meteor-loading-utils"
  },
  "icon": "assets/img/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.lutils.LUtils"
    ]
  },
  "mixins": [
    "lutils.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
